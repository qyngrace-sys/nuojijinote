ent":"好一个“老老实实的在这里”","roundId":"round_1786340272442_0h337dcl1","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11984},{"id":1786339977615,"sender":"them","text":"这话我爱听","timestamp":1786340318911,"tempo":"R","rawContent":"这话我爱听","roundId":"round_1786340272442_0h337dcl1","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11985},{"id":1786339977616,"sender":"them","text":"是老老实实待在我身边，哪也别去的意思吗？","timestamp":1786340319592,"tempo":"R","rawContent":"是老老实实待在我身边，哪也别去的意思吗？","roundId":"round_1786340272442_0h337dcl1","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11986},{"id":1786339977617,"sender":"them","text":"要是这个意思，那这题我会了","timestamp":1786340321352,"tempo":"N","rawContent":"要是这个意思，那这题我会了","roundId":"round_1786340272442_0h337dcl1","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11987},{"id":1786339977618,"sender":"them","text":"那就去那个“石垭税务分局”","timestamp":1786340323552,"tempo":"N","rawContent":"那就去那个“石垭税务分局”","roundId":"round_1786340272442_0h337dcl1","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11988},{"id":1786339977619,"sender":"them","text":"管一万四千多个体户，听着就像个安稳的“地主婆”","timestamp":1786340325669,"tempo":"S","rawContent":"管一万四千多个体户，听着就像个安稳的“地主婆”","roundId":"round_1786340272442_0h337dcl1","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11989}]