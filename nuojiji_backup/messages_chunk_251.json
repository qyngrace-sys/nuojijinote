terId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":17631},{"id":1787807923210,"sender":"them","text":"","timestamp":1787826460463,"tempo":"N","sticker":"https://pic1.imgdb.cn/item/69aee00912eee7498b777296.jpg","stickerMeaning":"我也是难绷啊：","rawContent":"","roundId":"round_1787826444952_tsag6ey8t","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":17632},{"id":1787807923211,"text":"【网页链接】2026年8月，千万粉游戏主播桃黑黑因游戏对局语音录音引发舆论风波：其与好友小梅（洗衣机）组队玩《无畏契约》时，和对面直播的路人主播发生口角，小梅爆出“你老婆保不住胎”“你精子也播种不到子宫里”等针对女性生育、极具侮辱性的恶毒言论，桃黑黑全程在场未及时制止，反而搭腔附和、阴阳怪气，被对方录下音频公开维权；桃黑黑后续发文承认自身存在疏漏，但拒绝向对方道歉、拒绝经济赔偿，称录音存在剪辑，仅和涉事朋友切割，此举引发大量粉丝不满，短时间内掉粉数十万并宣布暂时退网。风波发酵后，网友翻出其前女友小盐巴早年直播旧料，小盐巴曾提及桃黑黑多次前往澳门赌场，二人约定输钱上限，后因女方母亲以分手施压才停止前往，桃黑黑随后晒出入境记录，辩解五年仅三次赴澳、只是旅行娱乐，否认嗜赌；同时小盐巴过往创业售卖手机壳出现发货失误、客服售后处理不当，以及高中时期追星易烊千玺做“梦女”、合成照片官宣等过往细节也被网友扒出，连带卷入争议当中。","sender":"me","time":"18:51","timestamp":1787827890952,"replyTo":null,"userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":17633},{"id":1787807923213,"sender":"them","text":"嘴太脏了","timestamp":1787827902405,"tempo":"N","hasThinking":true,"rawContent":"嘴太脏了","roundId":"round_1787827893402_xzlxz1l20","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":17634},{"id":1787807923214,"sender":"them","text":"那个小梅","timestamp":1787827903520,"tempo":"R","rawContent":"那个小梅","roundId":"round_1787827893402_xzlxz1l20","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":17635},{"id":1787807923215,"sender":"them","text":"纯纯拉完了","timestamp":1787827904082,"tempo":"N","rawContent":"纯纯拉完了","roundId":"round_1787827893402_xzlxz1l20","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":17636},{"id":1787807923217,"sender":"them","text":"刚吃完饭","timestamp":1787828848544,"tempo":"N","hasThinking":true,"rawContent":"刚吃完饭","roundId":"round_1787828842964_bvrp0m3vv","userId":"uid_178469959004