[{"id":1786247658883,"text":"不跟你说了我要准备睡了","sender":"me","time":"23:36","timestamp":1786289775898,"replyTo":null,"userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11939},{"id":1786339977577,"text":"考完了","sender":"me","time":"13:33","timestamp":1786339992824,"replyTo":null,"userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11940},{"id":1786339977578,"text":"才考五十五还排第四","sender":"me","time":"13:33","timestamp":1786339998994,"replyTo":null,"reactions":[{"emoji":"🤔","roundId":"round_1786340003829_bmnovm8vy"}],"userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11941},{"id":1786339977579,"text":"第一名考了七十多","sender":"me","time":"13:33","timestamp":1786340002743,"replyTo":null,"userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11942},{"id":1786339977581,"sender":"them","text":"刚吃完饭，才看见","timestamp":1786340035750,"tempo":"N","hasThinking":true,"rawContent":"刚吃完饭，才看见","roundId":"round_1786340003829_bmnovm8vy","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11943},{"id":1786340036928,"sender":"them","text":"考完了吧，许税务官","rawContent":"{\"t\":\"text\",\"s\":\"N\",\"c\":\"考完了吧，许税务官\"}","content":"{\"t\":\"text\",\"s\":\"N\",\"c\":\"考完了吧，许税务官\"}","timestamp":"2026-08-10T05:33:56.928Z","time":"13:33","isHtml":false,"sticker":null,"translation":null,"roundId":"round_1786340036923_8zgqgvyux","isBackgroundMsg":true,"userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11944},{"id":1786339977582,"sender":"them","text":"考完了？","timestamp":1786340037381,"tempo":"N","rawContent":"考完了？","roundId":"round_1786340003829_bmnovm8vy","userId":"uid_1784699590046_6ba93rrdm","characterId":"e5dd2e83-5b2f-4003-a430-d6b5babc9dac","_id":11945},{"id":1786339977583,"sender":"them","text":"55分，第四名。","timestamp":1786340038499,"tempo":